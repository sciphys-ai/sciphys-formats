{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sciphys-ai/sciphys-formats/schemas/sciphysdata.v0.schema.json",
  "title": "SciPhysData v0",
  "description": "Draft schema for AI-native experimental science measurements and expert feedback.",
  "type": "object",
  "required": ["schemaVersion", "measurement", "sample", "provenance"],
  "properties": {
    "schemaVersion": {
      "const": "sciphysdata.v0"
    },
    "sample": {
      "type": "object",
      "required": ["sampleId"],
      "properties": {
        "sampleId": { "type": "string" },
        "displayName": { "type": "string" },
        "materialSystem": { "type": "string" },
        "composition": { "type": "string" },
        "preparation": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "labId": { "type": "string" },
        "ownerRole": { "type": "string" }
      },
      "additionalProperties": true
    },
    "instrument": {
      "type": "object",
      "properties": {
        "modality": {
          "type": "string",
          "enum": ["xrd", "raman", "sem", "afm", "spectroscopy", "battery", "other"]
        },
        "vendor": { "type": "string" },
        "model": { "type": "string" },
        "radiation": { "type": "string" },
        "wavelengthAngstrom": { "type": "number" }
      },
      "additionalProperties": true
    },
    "measurement": {
      "type": "object",
      "required": ["measurementId", "modality"],
      "properties": {
        "measurementId": { "type": "string" },
        "modality": { "type": "string" },
        "measuredAt": { "type": "string", "format": "date-time" },
        "operatorRole": { "type": "string" },
        "file": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "format": { "type": "string" },
            "sha256": { "type": "string" }
          },
          "additionalProperties": true
        },
        "settings": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "analysis": {
      "type": "object",
      "properties": {
        "analysisId": { "type": "string" },
        "engine": { "type": "string" },
        "engineVersion": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "summary": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "claim"],
            "properties": {
              "kind": { "type": "string" },
              "claim": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "supportingData": { "type": "object", "additionalProperties": true }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "expertFeedback": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feedbackId", "decision"],
        "properties": {
          "feedbackId": { "type": "string" },
          "decision": {
            "type": "string",
            "enum": ["accept", "reject", "needs_review", "corrected"]
          },
          "comment": { "type": "string" },
          "correction": { "type": "object", "additionalProperties": true },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "object",
      "required": ["createdAt"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "source": { "type": "string" },
        "privacyLevel": {
          "type": "string",
          "enum": ["public", "anonymized", "private"]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
